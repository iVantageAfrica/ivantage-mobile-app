{
  "name": "ivantage-mobile-app",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start_app": "npx expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "publish": "expo publish --config ./clients/client.json --release-channel dev",
    "build-ivantage-android-staging": "APP_ENV=ivantage APP_CONFIG=dev eas build --platform=android --profile=staging",
    "build-ivantage-android-preprd": "APP_ENV=ivantage APP_CONFIG=production eas build --platform=android --profile=preproduction",
    "build-ivantage-android-prd": "APP_ENV=ivantage APP_CONFIG=production eas build --platform=android --profile=production",
    "build-ivantage-ios-prd": "APP_ENV=ivantage APP_CONFIG=production eas build --platform=ios --profile=production",
    "build-ivantage-android": "expo build:android --config ./clients/client.json",
    "build-ivantage-ios": "expo build:ios --config ./clients/client.json",
    "publish_stg": "APP_ENV=ivantage eas update --channel staging",
    "publish_prd": "APP_ENV=ivantage eas update --channel production",
    "eject": "expo eject"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^4",
    "@native-base/icons": "^0.0.11",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native/metro-babel-transformer": "^0.76.3",
    "@react-navigation/bottom-tabs": "^6.3.1",
    "@react-navigation/material-top-tabs": "^6.2.1",
    "@react-navigation/native": "^6.0.10",
    "@react-navigation/native-stack": "^6.6.2",
    "axios": "^0.27.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "~53.0.0",
    "expo-application": "~6.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.8",
    "expo-document-picker": "~13.0.1",
    "expo-font": "~13.0.2",
    "expo-linear-gradient": "~14.1.4",
    "expo-local-authentication": "~15.0.1",
    "expo-media-library": "~17.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-splash-screen": "~0.29.18",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.10",
    "expo-web-browser": "~14.0.1",
    "fs-extra": "^11.3.0",
    "metro-react-native-babel-transformer": "^0.77.0",
    "native-base": "^3.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-currency-input": "^1.0.1",
    "react-native-form-validator": "^0.5.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-pager-view": "6.5.1",
    "react-native-qrcode-styled": "^0.3.3",
    "react-native-raw-bottom-sheet": "^2.2.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.11.1",
    "react-native-tab-view": "^3.1.1",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-optional-chaining": "^7.0.0-0",
    "expo": "^53.0.9",
    "react-native-svg-transformer": "^1.0.0"
  },
  "private": true
}
