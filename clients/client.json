{
  "expo": {
    "owner": "richardboyewa",
    "name": "iVantage Mobile",
    "slug": "ivantage-mobile-app",
    "version": "7.3.0",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD",
      "enabled": true,
      "url": "https://u.expo.dev/a05dc75a-0aa1-433b-afea-ad8f24e8e67a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "12.0.0",
      "bundleIdentifier": "africa.ivantage.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app wants to use your Face ID for authentication. Select Ok to allow."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "africa.ivantage.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 21,
      "permissions": []
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "client_slug": "ivantage",
      "client_host_wallet_name": "iVantage Mobile",
      "client_host_bank_code": "100024",
      "client_display_name": "iVantage",
      "client_account_opening_display_text": "Open an Account and start saving towards your equity",
      "eas": {
        "projectId": "a05dc75a-0aa1-433b-afea-ad8f24e8e67a"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
