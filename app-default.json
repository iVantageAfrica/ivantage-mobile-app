{
  "expo": {
    "owner": "richardboyewa",
    "name": "ivantage-mobile-rn",
    "slug": "ivantage-mobile-rn",
    "version": "1.3.1",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "africa.ivantage.app"
    },
    "android": {
      "hermesEnabled": true,
      "package": "africa.ivantage.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "client_slug": "ivantage",
      "client_host_wallet_name": "iVantage Mobile",
      "client_display_name": "iVantage",
      "client_account_opening_display_text": "Open an iVantage Account and start saving towards your equity"
    }
  }
}
