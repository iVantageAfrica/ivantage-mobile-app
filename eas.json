{
  "cli": {
    "version": ">= 3.7.0"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "ios": {
        "resourceClass": "medium"
      },
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
         "resourceClass": "medium"
      },
      "channel": "production",
      "env": {
        "APP_CONFIG": "production"
      }
    },
    "preproduction": {
      "android": {
        "buildType": "apk",
         "resourceClass": "medium"
      },
      "environment": "production",
      "channel": "production",
      "env": {
        "APP_CONFIG": "production"
      }
    },
    "staging": {
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "environment": "development",
      "channel": "staging",
      "env": {
        "APP_CONFIG": "dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
